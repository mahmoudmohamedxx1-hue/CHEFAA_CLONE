import { useState, useMemo } from 'react';
import { useParams } from 'react-router-dom';
import { useProducts } from '../hooks/useProducts';
import { useCategory } from '../hooks/useCategories';
import { Product } from '../lib/supabase';
import ProductCard from '../components/ProductCard';
import { ProductListSkeleton } from '../components/Skeleton';
import EnhancedSearchBar from '../components/EnhancedSearchBar';
import EnhancedFilters from '../components/EnhancedFilters';
import { ChevronRight, ChevronLeft, Search, Loader2 } from 'lucide-react';

type CategoryPageProps = {
  language: 'ar' | 'en';
  onAddToCart: (product: Product) => void;
};

interface FilterState {
  priceRange: string[];
  brand: string[];
  rating: string[];
  inStock: boolean;
}

export default function CategoryPage({ language, onAddToCart }: CategoryPageProps) {
  const { slug } = useParams<{ slug: string }>();
  
  // Fetch data with React Query
  const { data: category, isLoading: categoryLoading } = useCategory(slug || '');
  const { data: allProducts = [], isLoading: productsLoading } = useProducts({ 
    categoryId: category?.id 
  });
  
  // Search and filter state
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedFilters, setSelectedFilters] = useState<Record<string, string[]>>({});
  const [selectedSort, setSelectedSort] = useState('name_asc');
  
  // Pagination state
  const [currentPage, setCurrentPage] = useState(1);
  const [productsPerPage] = useState(12);

  const t = (ar: string, en: string) => language === 'ar' ? ar : en;

  const loading = categoryLoading || productsLoading;
    let filtered = [...allProducts];

    // Apply search query
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      filtered = filtered.filter(product => 
        product.name.toLowerCase().includes(query) ||
        product.description?.toLowerCase().includes(query) ||
        product.name_ar?.toLowerCase().includes(query)
      );
    }

    // Apply filters
    Object.entries(selectedFilters).forEach(([filterKey, values]) => {
      if (values.length > 0) {
        filtered = filtered.filter(product => {
          switch (filterKey) {
            case 'brand':
              return values.includes(product.brand || '');
            case 'priceRange':
              return values.some(range => {
                const price = product.price;
                switch (range) {
                  case 'under-50': return price < 50;
                  case '50-100': return price >= 50 && price < 100;
                  case '100-200': return price >= 100 && price < 200;
                  case 'over-200': return price >= 200;
                  default: return true;
                }
              });
            case 'rating':
              return values.includes(Math.floor(product.rating || 0).toString());
            case 'inStock':
              return product.stock_quantity > 0;
            default:
              return true;
          }
        });
      }
    });

    // Apply sorting
    filtered.sort((a, b) => {
      switch (selectedSort) {
        case 'name_asc':
          return a.name.localeCompare(b.name);
        case 'name_desc':
          return b.name.localeCompare(a.name);
        case 'price_asc':
          return a.price - b.price;
        case 'price_desc':
          return b.price - a.price;
        case 'rating_desc':
          return (b.rating || 0) - (a.rating || 0);
        default:
          return 0;
      }
    });

    return filtered;
  }, [allProducts, searchQuery, selectedFilters, selectedSort]);

  // Paginate filtered products
  const indexOfLastProduct = currentPage * productsPerPage;
  const indexOfFirstProduct = indexOfLastProduct - productsPerPage;
  const currentProducts = filteredProducts.slice(indexOfFirstProduct, indexOfLastProduct);
  const totalPages = Math.ceil(filteredProducts.length / productsPerPage);

    // If category doesn't exist in categories table, create a synthetic one
    if (!categoryData && slug) {
      // Convert slug to display name
      const displayName = slug
        .split('-')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
      
      categoryToUse = {
        id: slug,
        name: displayName,
        name_ar: displayName,
        slug: slug,
        description: `${displayName} products`
      };
    }

    if (categoryToUse) {
      setCategory(categoryToUse);

      // Load products in this category
      const { data: productsData } = await supabase
        .from('products')
        .select('*')
        .eq('category', slug)
        .order('name');

      if (productsData) {
        setAllProducts(productsData);
      }
    }

    setLoading(false);
  };

  // Filter configuration for EnhancedFilters
  const filterGroups = [
    {
      id: 'brand',
      label: t('العلامة التجارية', 'Brand'),
      type: 'checkbox' as const,
      options: [
        { id: 'panadol', label: 'Panadol', count: 45 },
        { id: 'brufen', label: 'Brufen', count: 32 },
        { id: 'cerave', label: 'CeraVe', count: 28 },
        { id: 'garnier', label: 'Garnier', count: 22 },
        { id: 'loreal', label: "L'Oreal", count: 18 },
      ],
    },
    {
      id: 'priceRange',
      label: t('السعر', 'Price'),
      type: 'radio' as const,
      options: [
        { id: 'under-50', label: t('أقل من ٥٠ جنيه', 'Under 50 EGP') },
        { id: '50-100', label: t('٥٠ - ١٠٠ جنيه', '50 - 100 EGP') },
        { id: '100-200', label: t('١٠٠ - ٢٠٠ جنيه', '100 - 200 EGP') },
        { id: 'over-200', label: t('أكثر من ٢٠٠ جنيه', 'Over 200 EGP') },
      ],
    },
    {
      id: 'rating',
      label: t('التقييم', 'Rating'),
      type: 'checkbox' as const,
      options: [
        { id: '4', label: t('٤ نجوم فأكثر', '4+ Stars') },
        { id: '3', label: t('٣ نجوم فأكثر', '3+ Stars') },
        { id: '2', label: t('٢ نجمة فأكثر', '2+ Stars') },
      ],
    },
    {
      id: 'inStock',
      label: t('التوفر', 'Availability'),
      type: 'radio' as const,
      options: [
        { id: 'available', label: t('متوفر', 'In Stock') },
      ],
    },
  ];

  const sortOptions = [
    { value: 'name_asc', label: t('الاسم (أ-ي)', 'Name (A-Z)') },
    { value: 'name_desc', label: t('الاسم (ي-أ)', 'Name (Z-A)') },
    { value: 'price_asc', label: t('السعر (الأقل أولاً)', 'Price (Low to High)') },
    { value: 'price_desc', label: t('السعر (الأعلى أولاً)', 'Price (High to Low)') },
    { value: 'rating_desc', label: t('التقييم (الأعلى أولاً)', 'Rating (High to Low)') },
  ];

  const handleFilterChange = (groupId: string, values: string[]) => {
    setSelectedFilters(prev => ({
      ...prev,
      [groupId]: values,
    }));
  };

  const handleClearFilters = () => {
    setSelectedFilters({});
    setSearchQuery('');
  };

  // Pagination calculations
  const totalPages = Math.ceil(filteredProducts.length / productsPerPage);
  const startIndex = (currentPage - 1) * productsPerPage;
  const endIndex = startIndex + productsPerPage;
  const currentProducts = filteredProducts.slice(startIndex, endIndex);

  const handlePageChange = (page: number) => {
    setCurrentPage(page);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const renderPagination = () => {
    if (totalPages <= 1) return null;

    const pages = [];
    const maxVisiblePages = 5;
    
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage < maxVisiblePages - 1) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }

    for (let i = startPage; i <= endPage; i++) {
      pages.push(i);
    }

    return (
      <div className="flex items-center justify-center gap-2 mt-8">
        <button
          onClick={() => handlePageChange(currentPage - 1)}
          disabled={currentPage === 1}
          className="flex items-center gap-1 px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <ChevronRight className="w-4 h-4" />
          {t('السابق', 'Previous')}
        </button>

        {startPage > 1 && (
          <>
            <button
              onClick={() => handlePageChange(1)}
              className="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50"
            >
              1
            </button>
            {startPage > 2 && <span className="text-gray-400">...</span>}
          </>
        )}

        {pages.map(page => (
          <button
            key={page}
            onClick={() => handlePageChange(page)}
            className={`px-3 py-2 rounded-lg border ${
              currentPage === page
                ? 'bg-brand-blue-500 text-white border-brand-blue-500'
                : 'border-gray-200 hover:bg-gray-50'
            }`}
          >
            {page}
          </button>
        ))}

        {endPage < totalPages && (
          <>
            {endPage < totalPages - 1 && <span className="text-gray-400">...</span>}
            <button
              onClick={() => handlePageChange(totalPages)}
              className="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50"
            >
              {totalPages}
            </button>
          </>
        )}

        <button
          onClick={() => handlePageChange(currentPage + 1)}
          disabled={currentPage === totalPages}
          className="flex items-center gap-1 px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t('التالي', 'Next')}
          <ChevronLeft className="w-4 h-4" />
        </button>
      </div>
    );
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-background-secondary py-8">
        <div className="container mx-auto px-4">
          <div className="animate-pulse">
            <div className="h-8 bg-gray-200 rounded w-1/4 mb-6"></div>
            <div className="h-12 bg-gray-200 rounded mb-6"></div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {[...Array(8)].map((_, i) => (
                <div key={i} className="bg-white p-4 rounded-lg">
                  <div className="aspect-square bg-gray-200 rounded-lg mb-3"></div>
                  <div className="h-4 bg-gray-200 rounded mb-2"></div>
                  <div className="h-4 bg-gray-200 rounded w-2/3"></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    );
  }

  if (!category) {
    return (
      <div className="min-h-screen bg-background-secondary py-8">
        <div className="container mx-auto px-4 text-center">
          <h1 className="text-2xl font-bold">{t('القسم غير موجود', 'Category not found')}</h1>
          <p className="text-text-secondary mt-2">{t('لم نتمكن من العثور على هذا القسم', 'We couldn\'t find this category')}</p>
        </div>
      </div>
    );
  }

  const categoryName = language === 'ar' ? category.name_ar : category.name;

  return (
    <div className="min-h-screen bg-background-secondary">
      {/* Breadcrumbs */}
      <div className="bg-white border-b">
        <div className="container mx-auto px-4 py-3">
          <div className="flex items-center gap-2 text-sm text-text-secondary">
            <a href="/" className="hover:text-brand-blue-500">{t('الرئيسية', 'Home')}</a>
            <ChevronRight className="w-4 h-4" />
            <span className="text-text-primary font-semibold">{categoryName}</span>
          </div>
        </div>
      </div>

      {/* Search and Filters */}
      <div className="bg-white border-b">
        <div className="container mx-auto px-4 py-6">
          <div className="flex flex-col lg:flex-row gap-6">
            {/* Search Bar */}
            <div className="flex-1">
              <EnhancedSearchBar
                language={language}
                onSearch={setSearchQuery}
                placeholder={t('ابحث في منتجات القسم...', 'Search products in this category...')}
              />
            </div>
            
            {/* Filters */}
            <div className="flex-shrink-0">
              <EnhancedFilters
                language={language}
                filterGroups={filterGroups}
                selectedFilters={selectedFilters}
                onFilterChange={handleFilterChange}
                onClearAll={handleClearFilters}
                sortOptions={sortOptions}
                selectedSort={selectedSort}
                onSortChange={setSelectedSort}
              />
            </div>
          </div>
        </div>
      </div>

      {/* Products Section */}
      <div className="container mx-auto px-4 py-8">
        {/* Results Info */}
        <div className="flex items-center justify-between mb-6">
          <div className="text-text-secondary">
            {searchQuery ? (
              <span>
                {t(`نتائج البحث عن "${searchQuery}"`, `Search results for "${searchQuery}"`)} • {filteredProducts.length} {t('منتج', 'products')}
              </span>
            ) : (
              <span>
                {filteredProducts.length} {t('منتج', 'products')}
                {Object.values(selectedFilters).some(filters => filters.length > 0) && 
                  ` • ${t('مفلتر', 'filtered')}`
                }
              </span>
            )}
          </div>
          
          {totalPages > 1 && (
            <div className="text-sm text-text-secondary">
              {t(`صفحة ${currentPage} من ${totalPages}`, `Page ${currentPage} of ${totalPages}`)}
            </div>
          )}
        </div>

        {/* Products Grid */}
        {currentProducts.length === 0 ? (
          <div className="text-center py-16">
            <div className="max-w-md mx-auto">
              <Search className="w-16 h-16 text-gray-300 mx-auto mb-4" />
              <h3 className="text-lg font-semibold mb-2">
                {searchQuery 
                  ? t('لا توجد نتائج للبحث', 'No search results found')
                  : t('لا توجد منتجات', 'No products found')
                }
              </h3>
              <p className="text-text-secondary mb-4">
                {searchQuery 
                  ? t('جرب البحث بكلمات مختلفة أو فلاتر أقل', 'Try different search terms or fewer filters')
                  : t('لا توجد منتجات تطابق الفلاتر المحددة', 'No products match the selected filters')
                }
              </p>
              <button
                onClick={handleClearFilters}
                className="px-6 py-2 bg-brand-blue-500 text-white rounded-lg hover:bg-brand-blue-600 transition-colors"
              >
                {t('مسح الفلاتر', 'Clear Filters')}
              </button>
            </div>
          </div>
        ) : (
          <>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {currentProducts.map((product) => (
                <ProductCard
                  key={product.id}
                  product={product}
                  language={language}
                  onAddToCart={onAddToCart}
                />
              ))}
            </div>
            
            {/* Pagination */}
            {renderPagination()}
          </>
        )}
      </div>
    </div>
  );
}
